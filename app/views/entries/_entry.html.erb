<div class="group relative">
  <%= link_to entry_path(entry) do%>
  <img src="<%= entry.image_url %>" alt="<%= entry.title %>" class="aspect-square w-full rounded-md bg-gray-200 object-cover group-hover:opacity-75 lg:aspect-auto lg:h-80">
  <% end %>
  <div class="mt-4 flex justify-between">
    <div>
      <h3 class="text-sm text-gray-700">
        <%=link_to entry.title, entry_path(entry)%>
      </h3>
      <p class="mt-1 text-sm text-gray-500"><%= truncate(entry.summary, length: 50) %></p>
    </div>
    <p class="text-sm font-medium text-gray-900"><%= entry.category %></p>
  </div>
</div>