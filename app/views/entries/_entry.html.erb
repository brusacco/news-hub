<div class="group relative">
  <%= link_to entry_path(entry) do%>
    <% if entry.site.id == 11 %>
      <img src="https://assets.nintendo.com/image/upload/v1643742733/ncom/global/social-share.jpg" alt="<%= entry.title %>" class="aspect-square w-full rounded-md bg-gray-200 object-cover group-hover:opacity-75 lg:aspect-auto lg:h-80">
    <% else %>
      <!-- Use the image URL from the entry object -->
      <%= image_tag(entry.image_url, alt: entry.title, class: "aspect-square w-full rounded-md bg-gray-200 object-cover group-hover:opacity-75 lg:aspect-auto lg:h-80") %>
    <% end %>
  <% end %>
  <div class="mt-4 flex justify-between">
    <div>
      <h3 class="text-2xl text-gray-700">
        <%=link_to entry.ai_title || entry.title, entry_path(entry)%>
      </h3>
    </div>
    <p class="text-sm font-medium text-gray-900"><%= entry.category %></p>
  </div>
</div>