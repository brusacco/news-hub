<div class="bg-white">
  <div class="mx-auto max-w-full px-4 py-2 sm:px-6 sm:py-10 lg:max-w-7xl lg:px-8">
    <div class="lg:grid lg:grid-cols-2 lg:items-start lg:gap-x-8">
      <!-- Entry info -->
      <div class="mt-10 px-4 sm:mt-16 sm:px-0 lg:mt-0">
        <h1 class="text-3xl font-bold tracking-tight text-gray-900"><%= @entry.ai_title || @entry.title %></h1>
        <div class="mt-3">
          <h2 class="sr-only">Entry information</h2>
          <p class="text-sm text-gray-500">Published on: <%= @entry.published_at.strftime('%B %d, %Y') %></p>
        </div>
        <div class="mt-6">
          <h3 class="sr-only">Description</h3>
          <div class="space-y-6 text-base text-gray-700">
            <p><%= raw(@entry.ai_content&.gsub('. ', '.<br><br>')) || @entry.description %></p>
            <p>
              <% @entry.tags.each do |tag| %>
                <span class="mt-3 inline-flex items-center rounded-full bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">
                  <%= link_to tag.name, tag_path(tag) %>
                </span>
              <%end%>
            </p>
          </div>
        </div>
      </div>
      <!-- Image gallery -->
      <div class="flex flex-col-reverse">
        <div>
          <div id="tabs-1-panel-1" aria-labelledby="tabs-1-tab-1" role="tabpanel" tabindex="0">
            <%if @entry.site.id == 11%>
              <img src="https://assets.nintendo.com/image/upload/v1643742733/ncom/global/social-share.jpg" alt="<%= @entry.title %>" class="aspect-square w-full object-cover sm:rounded-lg">
            <%else%>
              <img src="<%= @entry.image_url %>" alt="<%= @entry.title %>" class="aspect-square w-full object-cover sm:rounded-lg">
            <%end%>
          </div>
        </div>
      </div>
    </div>
    <% if @entries.any? %>
    <div class="mx-auto max-w-2xl py-4 sm:py-12 lg:max-w-7xl ">
      <h2 class="text-2xl font-bold tracking-tight text-gray-900">Related</h2>
      <div class="mt-6 grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-3 xl:gap-x-8">
        <%= render partial: 'entries/entry', collection: @entries %>
      </div>
    </div>
    <% end %>
  </div>
</div>