<div class="bg-white">
  <!-- Breadcrumbs -->
  <div class="mx-auto max-w-3xl px-4 pt-12 sm:px-6 lg:px-8">
    <%= render 'layouts/breadcrumbs' %>
  </div>
  
  <!-- Article Header -->
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <!-- Header -->
    <header class="mb-8">
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
        <%= @entry.ai_title || @entry.title %>
      </h1>
      <div class="mt-6 flex items-center gap-4 text-sm text-slate-600">
        <time datetime="<%= @entry.published_at.iso8601 %>" class="flex items-center">
          <svg class="mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 005.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
          </svg>
          <%= @entry.published_at.strftime('%B %d, %Y') %>
        </time>
      </div>
    </header>

    <!-- Featured Image -->
    <div class="mb-12 overflow-hidden rounded-2xl bg-slate-100">
      <% if @entry.site.id == 11 %>
        <img 
          src="https://assets.nintendo.com/image/upload/v1643742733/ncom/global/social-share.jpg" 
          alt="<%= @entry.final_title %> - Featured Image" 
          class="h-full w-full object-cover"
          loading="eager"
          width="1200"
          height="675"
        >
      <% else %>
        <img 
          src="<%= @entry.image_url %>" 
          alt="<%= @entry.final_title %> - Featured Image" 
          class="h-full w-full object-cover"
          loading="eager"
          width="1200"
          height="675"
        >
      <% end %>
    </div>

    <!-- Article Content -->
    <div class="space-y-6 text-base leading-8 text-slate-700 lg:text-lg lg:leading-9">
      <div class="prose prose-slate max-w-none">
        <%= raw(@entry.ai_content&.gsub('. ', '.<br><br>')) || @entry.description %>
      </div>
    </div>

    <!-- Tags -->
    <% if @entry.tags.any? %>
      <div class="mt-10 border-t border-slate-200 pt-8">
        <h3 class="text-sm font-semibold text-slate-900">Topics</h3>
        <div class="mt-4 flex flex-wrap gap-2">
          <% @entry.tags.each do |tag| %>
            <%= link_to tag_path(tag), class: "inline-flex items-center rounded-full bg-indigo-50 px-3 py-1 text-sm font-medium text-indigo-700 ring-1 ring-inset ring-indigo-600/20 transition-colors hover:bg-indigo-100" do %>
              <%= tag.name %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </article>

  <!-- Related Articles -->
  <% if @entries.any? %>
    <div class="border-t border-slate-200 bg-slate-50">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <div class="mb-10">
          <h2 class="text-3xl font-bold tracking-tight text-slate-900">Related Articles</h2>
          <p class="mt-2 text-base text-slate-600">Continue reading more Nintendo news</p>
        </div>
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
          <%= render partial: 'entries/entry', collection: @entries %>
        </div>
      </div>
    </div>
  <% end %>
</div>