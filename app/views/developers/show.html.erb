<div class="bg-white">
  <div class="mx-auto max-w-7xl px-6 pt-12 lg:px-8">
    <%= render 'layouts/breadcrumbs' %>
  </div>

  <section class="relative isolate overflow-hidden <%= @developer.image_background.present? ? 'bg-slate-950' : 'bg-gradient-to-b from-red-50/30 via-white to-white' %>">
    <% if @developer.image_background.present? %>
      <%= image_tag(
        @developer.image_background,
        alt: "#{@developer.name} Nintendo Switch games",
        class: "absolute inset-0 -z-10 h-full w-full object-cover opacity-45",
        width: 1600,
        height: 900
      ) %>
      <div class="absolute inset-0 -z-10 bg-gradient-to-t from-slate-950 via-slate-950/75 to-slate-950/40"></div>
    <% end %>

    <div class="mx-auto max-w-7xl px-6 pb-16 pt-10 sm:pb-20 lg:px-8 lg:pt-16">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-wide <%= @developer.image_background.present? ? 'text-[#FFCCCF]' : 'text-[#E60012]' %>">Game Developer</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight <%= @developer.image_background.present? ? 'text-white' : 'text-slate-900' %> sm:text-5xl"><%= @developer.name %> Games</h1>
        <p class="mt-6 text-lg leading-8 <%= @developer.image_background.present? ? 'text-slate-200' : 'text-slate-600' %>">
          Browse Nintendo Switch releases developed by <%= @developer.name %>, with ratings, genres, and related news
          coverage where available.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1600px] px-4 py-12 sm:px-6 lg:px-8 lg:py-16" aria-label="<%= @developer.name %> Nintendo Switch games listing">
    <% if @matching_tag.present? %>
      <section class="mb-10 rounded-2xl bg-slate-50 px-6 py-8 ring-1 ring-slate-200">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Developer Page vs. News Topic</h2>
        <p class="mt-4 text-base leading-7 text-slate-600">
          This page is the Nintendo Switch developer catalog for <strong class="font-semibold text-slate-900"><%= @developer.name %></strong>,
          focused on linked games, genres, and studio context. For the article archive and ongoing coverage, see
          <%= link_to "#{@matching_tag.name} news topic", tag_path(@matching_tag), class: "font-medium text-[#E60012] hover:text-[#CC0010]" %>.
        </p>
      </section>
    <% end %>

    <% if @developer.description.present? || @developer_supporting_copy.any? %>
      <section class="mb-10 rounded-2xl bg-slate-50 px-6 py-8 ring-1 ring-slate-200">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">About <%= @developer.name %></h2>
        <% if @developer.description.present? %>
          <div class="prose prose-slate mt-4 max-w-none">
            <%= sanitize(@developer.description, tags: %w[p br strong em b i ul ol li a blockquote h2 h3], attributes: %w[href rel target]) %>
          </div>
        <% end %>
        <% if @developer_supporting_copy.any? %>
          <div class="prose prose-slate mt-4 max-w-none">
            <% @developer_supporting_copy.each do |paragraph| %>
              <p><%= paragraph %></p>
            <% end %>
          </div>
        <% end %>
      </section>
    <% end %>

    <% if @top_genres.any? %>
      <section class="mb-10 rounded-2xl bg-white px-6 py-8 shadow-sm ring-1 ring-slate-200">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Popular Genres by <%= @developer.name %></h2>
        <p class="mt-2 max-w-3xl text-base leading-7 text-slate-600">
          Explore the Nintendo Switch genres where <%= @developer.name %> appears most often.
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <% @top_genres.each do |genre| %>
            <%= link_to genre.name, genre_path(genre), class: "inline-flex items-center rounded-full bg-slate-100 px-4 py-2 text-sm font-medium text-slate-700 ring-1 ring-inset ring-slate-200 transition-colors hover:bg-[#FFE5E7] hover:text-[#E60012]" %>
          <% end %>
        </div>
      </section>
    <% end %>

    <header class="mb-10">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900">Popular <%= @developer.name %> Nintendo Switch Games</h2>
      <p class="mt-2 max-w-3xl text-base leading-7 text-slate-600">
        Explore Nintendo Switch games linked to <%= @developer.name %>. Games are ordered by popularity so the most
        recognized titles appear first.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <%= link_to 'All Developers', developers_path, class: "inline-flex items-center rounded-full bg-slate-100 px-4 py-2 text-sm font-medium text-slate-700 ring-1 ring-inset ring-slate-200 transition-colors hover:bg-[#FFE5E7] hover:text-[#E60012]" %>
        <%= link_to 'All Games', games_path, class: "inline-flex items-center rounded-full bg-slate-100 px-4 py-2 text-sm font-medium text-slate-700 ring-1 ring-inset ring-slate-200 transition-colors hover:bg-[#FFE5E7] hover:text-[#E60012]" %>
      </div>
    </header>

    <% if @games.any? %>
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        <%= render partial: 'games/game', collection: @games %>
      </div>

      <% if @pagy.pages > 1 %>
        <nav class="mt-12 flex justify-center" aria-label="Pagination">
          <div class="rounded-lg bg-white px-4 py-3 shadow-sm ring-1 ring-slate-200">
            <%== pagy_nav(@pagy) %>
          </div>
        </nav>
      <% end %>
    <% else %>
      <p class="rounded-lg bg-slate-50 p-6 text-slate-700 ring-1 ring-slate-200">
        No imported games are linked to this developer yet. Run the RAWG developer sync to populate it.
      </p>
    <% end %>

    <% if @related_entries.any? %>
      <section class="mt-16">
        <div class="mb-8">
          <h2 class="text-2xl font-bold tracking-tight text-slate-900"><%= @developer.name %> News</h2>
          <p class="mt-2 max-w-3xl text-base leading-7 text-slate-600">
            Read Nintendo news articles connected to games developed by <%= @developer.name %>.
          </p>
        </div>
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
          <%= render partial: 'entries/entry', collection: @related_entries %>
        </div>
      </section>
    <% end %>
  </section>
</div>
