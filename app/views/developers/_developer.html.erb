<%= link_to developer_path(developer), class: "group relative flex flex-col overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-slate-200 transition-all duration-300 hover:shadow-lg hover:ring-slate-300", itemscope: true, itemtype: "https://schema.org/Organization" do %>
  <div class="aspect-[16/9] w-full overflow-hidden bg-slate-100 relative">
    <% if developer.image_background.present? %>
      <%= image_tag(
        developer.image_background,
        alt: "#{developer.name} - Nintendo Switch game developer",
        class: "h-full w-full object-cover transition-transform duration-300 group-hover:scale-105",
        loading: "lazy",
        width: 400,
        height: 225,
        itemprop: "image"
      ) %>
    <% else %>
      <img
        src="https://assets.nintendo.com/image/upload/v1643742733/ncom/global/social-share.jpg"
        alt="<%= developer.name %> - Nintendo Switch game developer"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        loading="lazy"
        width="400"
        height="225"
        itemprop="image"
      >
      <% end %>
    </div>
    <div class="flex flex-1 flex-col p-6">
      <div class="flex-1">
        <h3 class="text-xl font-semibold leading-7 text-slate-900 line-clamp-2" itemprop="name">
          <%= developer.name %>
        </h3>
      </div>
      <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-slate-600">
        <span class="inline-flex items-center rounded-full bg-[#FFE5E7] px-3 py-1 text-xs font-medium text-[#E60012] ring-1 ring-inset ring-[#E60012]/20">
          <%= pluralize(developer.local_games_count.to_i, 'game') %>
        </span>
      </div>
    </div>
  <% end %>
