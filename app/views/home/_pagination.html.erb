<% if pagy.pages > 1 %>
<div class="flex items-center justify-between border-t border-gray-200 bg-white px-4 py-3 sm:px-6">
  <div class="flex flex-1 justify-between sm:hidden">
    <%= link_to 'Previous', url_for(request.query_parameters.merge(page: pagy.prev)), class: 'relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50' if pagy.prev %>
    <%= link_to 'Next', url_for(request.query_parameters.merge(page: pagy.next)), class: 'relative ml-3 inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50' if pagy.next %>
  </div>
  <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
    <div>
      <p class="text-sm text-gray-700">
        Showing
        <span class="font-medium"><%= pagy.from %></span>
        to
        <span class="font-medium"><%= pagy.to %></span>
        of
        <span class="font-medium"><%= pagy.count %></span>
        results
      </p>
    </div>
    <div>
      <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
        <%= link_to '', url_for(request.query_parameters.merge(page: pagy.prev)), class: 'relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0', aria: { label: 'Previous' } if pagy.prev %>
        <%== pagy_nav(pagy) %>
        <%= link_to '', url_for(request.query_parameters.merge(page: pagy.next)), class: 'relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0', aria: { label: 'Next' } if pagy.next %>
      </nav>
    </div>
  </div>
</div>
<% end %>