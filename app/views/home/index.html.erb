<div class="bg-white">
  <!-- Hero Section -->
  <div class="relative isolate overflow-hidden bg-gradient-to-b from-indigo-50/20 via-white to-white">
    <div class="mx-auto max-w-7xl px-6 pb-24 pt-10 sm:pb-32 lg:px-8 lg:pt-16">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-6xl">
          Best Nintendo News
          <span class="text-indigo-600">Online</span>
        </h1>
        <p class="mt-6 text-lg leading-8 text-slate-600">
          Stay updated with the latest news, updates, and insights from the world of Nintendo. 
          Your trusted source for everything Nintendo.
        </p>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <!-- Section Header -->
    <div class="mb-12">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900">Latest News</h2>
      <p class="mt-2 text-base text-slate-600">Discover the most recent articles and updates</p>
    </div>

    <!-- Articles Grid -->
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <%= render partial: 'entries/entry', collection: @entries %>
    </div>

    <!-- Pagination -->
    <% if @pagy.pages > 1 %>
      <div class="mt-12 flex justify-center">
        <div class="rounded-lg bg-white px-4 py-3 shadow-sm ring-1 ring-slate-200">
          <%== pagy_nav(@pagy) %>
        </div>
      </div>
    <% end %>
  </div>
</div>
