<div class="bg-white">
  <!-- Main Content -->
  <div class="mx-auto max-w-full px-4 py-4 sm:px-6 sm:py-10 lg:max-w-full lg:px-8">
    <div class="border-b border-gray-200 pb-5">
      <h1 class="text-4xl font-bold tracking-tight text-gray-900">Searched for: <%=@keyword%></h1>
      <p class="mt-4 text-base text-gray-500">Checkout out the latest news from <%=@keyword%>.</p>
    </div>
    <div class="mt-6 grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-3 xl:gap-x-8">
      <%= render partial: 'entries/entry', collection: @entries %>
    </div>
    <div class="flex justify-center mt-4">
      <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
    </div>
  </div>
</div>
