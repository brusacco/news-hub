<div class="bg-white">
  <!-- Search Results Header -->
  <div class="border-b border-slate-200 bg-gradient-to-b from-red-50/30 via-white to-white">
    <div class="mx-auto max-w-[1600px] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          Search Results
        </h1>
        <p class="mt-4 text-lg leading-8 text-slate-600">
          Nintendo news results for: <span class="font-semibold text-[#E60012]"><%= @keyword %></span>
        </p>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="mx-auto max-w-[1600px] px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <!-- Articles Grid -->
    <% if @entries.any? %>
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        <%= render partial: 'entries/entry', collection: @entries %>
      </div>

      <!-- Pagination -->
      <% if @pagy.pages > 1 %>
        <nav class="mt-12 flex justify-center" aria-label="Pagination">
          <div class="rounded-lg bg-white px-4 py-3 shadow-sm ring-1 ring-slate-200">
            <%== pagy_nav(@pagy) %>
          </div>
        </nav>
      <% end %>
    <% else %>
      <div class="text-center py-16">
        <svg class="mx-auto h-12 w-12 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
        </svg>
        <h3 class="mt-4 text-lg font-semibold text-slate-900">No results found</h3>
        <p class="mt-2 text-sm text-slate-600">Try searching with different keywords.</p>
      </div>
    <% end %>
  </div>
</div>
