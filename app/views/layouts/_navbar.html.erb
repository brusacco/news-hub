<nav class="fixed top-0 left-0 right-0 z-[100] border-b border-slate-200 bg-white/95 backdrop-blur-md shadow-sm supports-[backdrop-filter]:bg-white/90">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <!-- Logo and Navigation -->
      <div class="flex items-center">
        <%= link_to root_path, class: "flex items-center space-x-2" do %>
          <span class="text-xl font-bold tracking-tight text-slate-900">NintendoNews</span>
        <% end %>
        <div class="hidden md:ml-10 md:block">
          <div class="flex items-center space-x-1">
            <%= link_to root_path, class: "rounded-lg px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-100 hover:text-slate-900 #{'bg-slate-100 text-slate-900' if request.path == root_path}" do %>
              Home
            <% end %>
            <%= link_to trending_path, class: "rounded-lg px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-100 hover:text-slate-900 #{'bg-slate-100 text-slate-900' if request.path == trending_path}" do %>
              Trends
            <% end %>
            <%= link_to tags_path, class: "rounded-lg px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-100 hover:text-slate-900 #{'bg-slate-100 text-slate-900' if request.path.include?('/tags')}" do %>
              Topics
            <% end %>
          </div>
        </div>
      </div>

      <!-- Search -->
      <div class="flex flex-1 items-center justify-end px-2 lg:ml-6 lg:px-0" data-controller="search" data-search-url-value="<%= search_autocomplete_path %>">
        <div class="relative w-full max-w-lg lg:max-w-xs">
          <form action="<%= search_path %>" method="get" class="relative">
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 z-10">
              <svg class="h-5 w-5 text-slate-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z" clip-rule="evenodd" />
              </svg>
            </div>
            <input 
              type="search" 
              name="keyword" 
              data-search-target="input"
              data-action="input->search#search keydown->search#handleKeydown keydown->search#submit"
              aria-label="Search articles" 
              aria-expanded="false"
              aria-haspopup="true"
              autocomplete="off"
              class="block w-full rounded-lg border-0 bg-slate-100 py-2 pl-10 pr-3 text-sm text-slate-900 placeholder:text-slate-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:text-sm" 
              placeholder="Search articles..."
            />
          </form>
          
          <!-- Dropdown Results -->
          <div 
            data-search-target="dropdown"
            class="hidden absolute top-full mt-2 w-full max-w-lg lg:max-w-xs rounded-xl bg-white shadow-lg ring-1 ring-slate-200 overflow-hidden z-[200]"
            role="menu"
            aria-orientation="vertical"
          >
            <div 
              data-search-target="results"
              class="max-h-96 overflow-y-auto"
            >
              <!-- Results will be inserted here -->
            </div>
          </div>
        </div>
      </div>

      <!-- Mobile menu button -->
      <div class="ml-4 md:hidden" data-controller="menu">
        <button 
          type="button" 
          data-action="menu#toggle" 
          class="inline-flex items-center justify-center rounded-lg p-2 text-slate-700 hover:bg-slate-100 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
          aria-expanded="false"
        >
          <span class="sr-only">Open main menu</span>
          <svg class="block h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-menu-target="openIcon">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
          <svg class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-menu-target="closeIcon">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div class="hidden border-t border-slate-200 bg-white md:hidden" data-menu-target="mobileMenu">
    <div class="space-y-1 px-2 pb-3 pt-2">
      <%= link_to root_path, class: "block rounded-lg px-3 py-2 text-base font-medium text-slate-700 hover:bg-slate-100 hover:text-slate-900 #{'bg-slate-100 text-slate-900' if request.path == root_path}" do %>
        Home
      <% end %>
      <%= link_to trending_path, class: "block rounded-lg px-3 py-2 text-base font-medium text-slate-700 hover:bg-slate-100 hover:text-slate-900 #{'bg-slate-100 text-slate-900' if request.path == trending_path}" do %>
        Trends
      <% end %>
      <%= link_to tags_path, class: "block rounded-lg px-3 py-2 text-base font-medium text-slate-700 hover:bg-slate-100 hover:text-slate-900 #{'bg-slate-100 text-slate-900' if request.path.include?('/tags')}" do %>
        Topics
      <% end %>
    </div>
  </div>
</nav>
