<%# Schema.org JSON-LD para Organization %>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Nintendo News Hub",
  "url": "<%= root_url %>",
  "logo": "<%= root_url %>apple-touch-icon.png",
  "description": "Your trusted source for the latest Nintendo news, updates, and insights.",
  "sameAs": [
    "https://www.facebook.com/nintendonewshub",
    "https://twitter.com/NintendoNewsHub"
  ]
}
</script>

<%# Schema.org for WebSite + SearchAction %>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Nintendo News Hub",
  "url": "<%= root_url %>",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "<%= search_url %>?keyword={search_term_string}",
    "query-input": "required name=search_term_string"
  },
  "inLanguage": "en-US"
}
</script>

<%# Schema.org para Article (solo en páginas de artículos) %>
<% if defined?(@entry) && @entry.present? %>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": "<%= j(@entry.final_title) %>",
  "description": "<%= j(@entry.final_description || @entry.description || '') %>",
  "image": {
    "@type": "ImageObject",
    "url": "<%= @entry.image_url.presence || root_url + 'apple-touch-icon.png' %>",
    "width": 1200,
    "height": 675
  },
  "datePublished": "<%= @entry.published_at&.iso8601 %>",
  "dateModified": "<%= @entry.updated_at&.iso8601 %>",
  "author": {
    "@type": "Organization",
    "name": "Nintendo News Hub",
    "url": "<%= root_url %>"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Nintendo News Hub",
    "logo": {
      "@type": "ImageObject",
      "url": "<%= root_url %>apple-touch-icon.png",
      "width": 180,
      "height": 180
    },
    "url": "<%= root_url %>"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "<%= entry_url(@entry) %>"
  },
  <% if @entry.tags.any? %>
  "keywords": "<%= @entry.tags.map(&:name).join(', ') %>",
  "about": [
    <% @entry.tags.each_with_index do |tag, index| %>
    {
      "@type": "Thing",
      "name": "<%= j(tag.name) %>"
    }<%= index < @entry.tags.length - 1 ? ',' : '' %>
    <% end %>
  ],
  <% end %>
  <% if defined?(@games) && @games.any? %>
  "mentions": [
    <% @games.each_with_index do |game, index| %>
    {
      "@type": "VideoGame",
      "name": "<%= j(game.name) %>",
      "url": "<%= game_url(game) %>"
    }<%= index < @games.length - 1 ? ',' : '' %>
    <% end %>
  ],
  <% end %>
  "articleSection": "<%= @entry.category || 'Gaming News' %>",
  "inLanguage": "en-US",
  "isAccessibleForFree": true,
  "copyrightYear": "<%= @entry.published_at&.year || Date.current.year %>",
  "copyrightHolder": {
    "@type": "Organization",
    "name": "Nintendo News Hub"
  }
}
</script>
<% end %>

<%# Schema.org for VideoGame pages %>
<% if defined?(@game) && @game.present? %>
<script type="application/ld+json">
<%=
  raw(
    {
      '@context': 'https://schema.org',
      '@type': 'VideoGame',
      name: @game.name,
      url: game_url(@game),
      image: @game.background_image.presence,
      datePublished: @game.released&.iso8601,
      gamePlatform: Array(@game.platforms).filter_map { |platform_data| platform_data.dig('platform', 'name') },
      genre: @game.genres.map(&:name),
      sameAs: "https://rawg.io/games/#{@game.slug}",
      subjectOf: @related_entries&.map do |entry|
        {
          '@type': 'NewsArticle',
          headline: entry.final_title,
          url: entry_url(entry)
        }
      end,
      applicationCategory: 'Game',
      inLanguage: 'en-US'
    }.compact.to_json
  )
%>
</script>
<% end %>

<%# Schema.org for Developer pages %>
<% if defined?(@developer) && @developer.present? %>
<script type="application/ld+json">
<%=
  raw(
    {
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: @developer.name,
      url: developer_url(@developer),
      description: @developer.description.presence || "Nintendo Switch games developed by #{@developer.name}.",
      image: @developer.image_background.presence,
      sameAs: "https://rawg.io/developers/#{@developer.slug}",
      knowsAbout: @games&.flat_map(&:genres)&.uniq(&:id)&.map(&:name),
      subjectOf: @games&.first(8)&.map do |game|
        {
          '@type': 'VideoGame',
          name: game.name,
          url: game_url(game)
        }
      end
    }.compact.to_json
  )
%>
</script>
<% end %>

<%# Schema.org para BreadcrumbList %>
