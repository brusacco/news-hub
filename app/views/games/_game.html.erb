<article class="group relative flex flex-col overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-slate-200 transition-all duration-300 hover:shadow-lg hover:ring-slate-300" itemscope itemtype="https://schema.org/VideoGame">
  <div class="aspect-[16/9] w-full overflow-hidden bg-slate-100 relative">
    <% if game.background_image.present? %>
      <%= image_tag(
        game.background_image,
        alt: "#{game.name} - Nintendo Switch game",
        class: "h-full w-full object-cover transition-transform duration-300 group-hover:scale-105",
        loading: "lazy",
        width: 400,
        height: 225,
        itemprop: "image"
      ) %>
    <% else %>
      <img
        src="https://assets.nintendo.com/image/upload/v1643742733/ncom/global/social-share.jpg"
        alt="<%= game.name %> - Nintendo Switch game"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        loading="lazy"
        width="400"
        height="225"
        itemprop="image"
      >
    <% end %>
  </div>

  <div class="flex flex-1 flex-col p-6">
    <div class="flex-1">
      <h3 class="text-xl font-semibold leading-7 text-slate-900 line-clamp-2" itemprop="name">
        <%= game.name %>
      </h3>

      <div class="mt-3 flex flex-wrap gap-2">
        <% Array(game.genres).first(3).each do |genre| %>
          <span class="inline-flex items-center rounded-full bg-[#FFE5E7] px-3 py-1 text-xs font-medium text-[#E60012] ring-1 ring-inset ring-[#E60012]/20">
            <%= genre['name'] %>
          </span>
        <% end %>
      </div>
    </div>

    <div class="mt-4 flex items-center justify-between gap-4">
      <div class="flex items-center gap-3 text-xs text-slate-500">
        <% if game.released.present? %>
          <time datetime="<%= game.released.iso8601 %>" class="flex items-center gap-1.5" itemprop="datePublished">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
            </svg>
            <%= game.released.strftime('%b %d, %Y') %>
          </time>
        <% elsif game.tba? %>
          <span>TBA</span>
        <% end %>
      </div>

      <% if game.metacritic.present? %>
        <span class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700 ring-1 ring-inset ring-slate-200">
          <%= game.metacritic %> MC
        </span>
      <% elsif game.rating.present? && game.rating.positive? %>
        <span class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700 ring-1 ring-inset ring-slate-200">
          <%= number_with_precision(game.rating, precision: 1) %>/<%= game.rating_top.presence || 5 %>
        </span>
      <% end %>
    </div>
  </div>
</article>
