<div class="bg-white">
  <div class="mx-auto max-w-7xl px-6 pt-12 lg:px-8">
    <%= render 'layouts/breadcrumbs' %>
  </div>

  <section class="relative isolate overflow-hidden bg-slate-950">
    <% if @game.background_image.present? %>
      <%= image_tag(
        @game.background_image,
        alt: "#{@game.name} - Nintendo Switch game",
        class: "absolute inset-0 -z-10 h-full w-full object-cover opacity-45",
        width: 1600,
        height: 900,
        itemprop: "image"
      ) %>
      <div class="absolute inset-0 -z-10 bg-gradient-to-t from-slate-950 via-slate-950/70 to-slate-950/40"></div>
    <% end %>

    <div class="mx-auto max-w-7xl px-6 pb-16 pt-16 sm:pb-20 lg:px-8 lg:pt-24">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-wide text-[#FFCCCF]">Nintendo Switch Game</p>
        <h1 class="mt-4 text-4xl font-bold tracking-tight text-white sm:text-6xl" itemprop="name"><%= @game.name %></h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-200">
          <%= @game.name %> is listed in our Nintendo Switch games database with release details, Metacritic data,
          platform information, and related genre pages.
        </p>

        <div class="mt-6 flex flex-wrap gap-3">
          <% if @game.released.present? %>
            <span class="inline-flex items-center rounded-full bg-white/10 px-4 py-2 text-sm font-medium text-white ring-1 ring-white/20">
              Released <%= @game.released.strftime('%b %d, %Y') %>
            </span>
          <% elsif @game.tba? %>
            <span class="inline-flex items-center rounded-full bg-white/10 px-4 py-2 text-sm font-medium text-white ring-1 ring-white/20">
              Release TBA
            </span>
          <% end %>

          <% if @game.metacritic.present? %>
            <span class="inline-flex items-center rounded-full bg-white/10 px-4 py-2 text-sm font-medium text-white ring-1 ring-white/20">
              <%= @game.metacritic %> Metacritic
            </span>
          <% end %>

        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1600px] px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_360px]">
      <main>
        <% if @game.genres.any? %>
          <section>
            <h2 class="text-2xl font-bold tracking-tight text-slate-900"><%= @game.name %> Genres</h2>
            <p class="mt-2 max-w-3xl text-base leading-7 text-slate-600">
              Explore more Nintendo Switch games in categories related to <%= @game.name %>.
            </p>
            <div class="mt-4 flex flex-wrap gap-3">
              <% @game.genres.each do |genre| %>
                <%= link_to genre.name, genre_path(genre), class: "inline-flex items-center rounded-full bg-[#FFE5E7] px-4 py-2 text-sm font-medium text-[#E60012] ring-1 ring-inset ring-[#E60012]/20 transition-colors hover:bg-[#FFCCCF]" %>
              <% end %>
            </div>
          </section>
        <% end %>

        <% if @game.screenshots.any? %>
          <section class="<%= @game.genres.any? ? 'mt-12' : '' %>" data-controller="screenshot-lightbox">
            <h2 class="text-2xl font-bold tracking-tight text-slate-900"><%= @game.name %> Screenshots</h2>
            <p class="mt-2 max-w-3xl text-base leading-7 text-slate-600">
              In-game screenshots imported from RAWG for <%= @game.name %>.
            </p>
            <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
              <% @game.screenshots.each do |screenshot| %>
                <a
                  href="<%= screenshot.image %>"
                  class="group overflow-hidden rounded-xl bg-slate-100 shadow-sm ring-1 ring-slate-200"
                  data-action="click->screenshot-lightbox#open"
                  data-screenshot-lightbox-target="item"
                  data-screenshot-lightbox-index="<%= screenshot.position %>"
                  data-screenshot-lightbox-url="<%= screenshot.image %>"
                  data-screenshot-lightbox-alt="<%= @game.name %> screenshot <%= screenshot.position + 1 %>"
                >
                  <%= image_tag(
                    screenshot.image,
                    alt: "#{@game.name} screenshot #{screenshot.position + 1}",
                    class: "h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]",
                    loading: "lazy",
                    width: screenshot.width.presence || 800,
                    height: screenshot.height.presence || 450
                  ) %>
                </a>
              <% end %>
            </div>

            <div
              class="fixed inset-0 z-[120] hidden bg-slate-950/85 p-4 sm:p-8"
              data-screenshot-lightbox-target="overlay"
              data-action="click->screenshot-lightbox#closeIfBackdrop"
            >
              <div class="flex h-full w-full items-center justify-center">
                <button
                  type="button"
                  class="absolute left-4 top-1/2 inline-flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20"
                  data-action="click->screenshot-lightbox#previous"
                  aria-label="Previous screenshot"
                >
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
                  </svg>
                </button>

                <button
                  type="button"
                  class="absolute right-4 top-1/2 inline-flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20"
                  data-action="click->screenshot-lightbox#next"
                  aria-label="Next screenshot"
                >
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                  </svg>
                </button>

                <button
                  type="button"
                  class="absolute right-4 top-4 inline-flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20"
                  data-action="click->screenshot-lightbox#close"
                  aria-label="Close screenshot viewer"
                >
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                  </svg>
                </button>

                <figure class="w-full max-w-6xl">
                  <img
                    src=""
                    alt=""
                    class="max-h-[80vh] w-full rounded-2xl object-contain"
                    data-screenshot-lightbox-target="image"
                  >
                  <figcaption
                    class="mt-4 text-center text-sm text-slate-200"
                    data-screenshot-lightbox-target="caption"
                  ></figcaption>
                </figure>
              </div>
            </div>
          </section>
        <% end %>

        <% if @related_games.any? %>
          <section class="mt-12">
            <h2 class="text-2xl font-bold tracking-tight text-slate-900">More Games Like <%= @game.name %></h2>
            <p class="mt-2 max-w-3xl text-base leading-7 text-slate-600">
              Browse other Nintendo Switch games that share genres with <%= @game.name %>.
            </p>
            <div class="mt-6 grid grid-cols-1 gap-8 sm:grid-cols-2 xl:grid-cols-3">
              <%= render partial: 'games/game', collection: @related_games %>
            </div>
          </section>
        <% end %>

        <% if @related_entries.any? %>
          <section class="mt-12">
            <h2 class="text-2xl font-bold tracking-tight text-slate-900"><%= @game.name %> News</h2>
            <p class="mt-2 max-w-3xl text-base leading-7 text-slate-600">
              Read Nintendo news articles connected to <%= @game.name %>.
            </p>
            <div class="mt-6 grid grid-cols-1 gap-8 sm:grid-cols-2 xl:grid-cols-3">
              <%= render partial: 'entries/entry', collection: @related_entries %>
            </div>
          </section>
        <% end %>
      </main>

      <aside class="space-y-6">
        <section class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
          <h2 class="text-lg font-semibold text-slate-900">Browse Games</h2>
          <div class="mt-4 flex flex-col gap-3">
            <%= link_to 'All Nintendo Switch Games', games_path, class: "text-sm font-medium text-[#E60012] hover:text-[#CC0010]" %>
            <%= link_to 'Nintendo Switch Genres', genres_path, class: "text-sm font-medium text-[#E60012] hover:text-[#CC0010]" %>
          </div>
        </section>

        <section class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
          <h2 class="text-lg font-semibold text-slate-900">Platforms</h2>
          <div class="mt-4 flex flex-wrap gap-2">
            <% Array(@game.platforms).each do |platform_data| %>
              <% platform_name = platform_data.dig('platform', 'name') %>
              <% next if platform_name.blank? %>

              <span class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700 ring-1 ring-inset ring-slate-200">
                <%= platform_name %>
              </span>
            <% end %>
          </div>
        </section>

      </aside>
    </div>
  </section>
</div>
