<div class="bg-white">
  <div class="mx-auto max-w-7xl px-6 pt-12 lg:px-8">
    <%= render 'layouts/breadcrumbs' %>
  </div>

  <section class="relative isolate overflow-hidden bg-gradient-to-b from-red-50/30 via-white to-white">
    <div class="mx-auto max-w-7xl px-6 pb-20 pt-10 sm:pb-24 lg:px-8 lg:pt-16">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-wide text-[#E60012]">Game Genre</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl"><%= @genre.name %> Games</h1>
        <p class="mt-6 text-lg leading-8 text-slate-600">
          Browse <%= @genre.name %> Nintendo Switch games with release dates, images, related genres, and score
          details where available.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1600px] px-4 py-12 sm:px-6 lg:px-8 lg:py-16" aria-label="<%= @genre.name %> Nintendo Switch games listing">
    <header class="mb-10">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900">Latest <%= @genre.name %> Nintendo Switch Games</h2>
      <p class="mt-2 max-w-3xl text-base leading-7 text-slate-600">
        Explore Nintendo Switch releases categorized as <%= @genre.name %>. Games are ordered by release date so
        newer releases appear first.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <%= link_to 'All Genres', genres_path, class: "inline-flex items-center rounded-full bg-slate-100 px-4 py-2 text-sm font-medium text-slate-700 ring-1 ring-inset ring-slate-200 transition-colors hover:bg-[#FFE5E7] hover:text-[#E60012]" %>
        <%= link_to 'All Games', games_path, class: "inline-flex items-center rounded-full bg-slate-100 px-4 py-2 text-sm font-medium text-slate-700 ring-1 ring-inset ring-slate-200 transition-colors hover:bg-[#FFE5E7] hover:text-[#E60012]" %>
      </div>
    </header>

    <% if @games.any? %>
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        <%= render partial: 'games/game', collection: @games %>
      </div>

      <% if @pagy.pages > 1 %>
        <nav class="mt-12 flex justify-center" aria-label="Pagination">
          <div class="rounded-lg bg-white px-4 py-3 shadow-sm ring-1 ring-slate-200">
            <%== pagy_nav(@pagy) %>
          </div>
        </nav>
      <% end %>
    <% else %>
      <p class="rounded-lg bg-slate-50 p-6 text-slate-700 ring-1 ring-slate-200">
        No imported games are linked to this genre yet. Run the RAWG game import or genre sync task to populate it.
      </p>
    <% end %>
  </section>
</div>
