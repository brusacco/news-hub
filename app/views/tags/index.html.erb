<div class="bg-white">
  <!-- Page Header -->
  <div class="border-b border-slate-200 bg-gradient-to-b from-indigo-50/20 via-white to-white">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          All Topics
        </h1>
        <p class="mt-4 text-lg leading-8 text-slate-600">
          Explore all topics and categories covered in our Nintendo news.
        </p>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="mb-8">
      <h2 class="text-2xl font-semibold text-slate-900">Browse by Topic</h2>
      <p class="mt-2 text-sm text-slate-600">Click on any topic to see related articles</p>
    </div>

    <!-- Tags Grid -->
    <div class="flex flex-wrap gap-3">
      <% @tags.each do |tag| %>
        <%= link_to tag_path(tag), class: "group inline-flex items-center rounded-xl bg-white px-4 py-2.5 text-sm font-medium text-slate-700 shadow-sm ring-1 ring-slate-200 transition-all hover:bg-indigo-50 hover:text-indigo-700 hover:ring-indigo-300" do %>
          <%= tag.name %>
          <svg class="ml-2 h-4 w-4 text-slate-400 transition-colors group-hover:text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        <% end %>
      <% end %>
    </div>

    <% if @tags.empty? %>
      <div class="text-center py-16">
        <p class="text-slate-600">No topics available at the moment.</p>
      </div>
    <% end %>
  </div>
</div>