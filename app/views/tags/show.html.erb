<div class="bg-white">
  <!-- Breadcrumbs -->
  <div class="mx-auto max-w-[1600px] px-4 pt-12 sm:px-6 lg:px-8">
    <%= render 'layouts/breadcrumbs' %>
  </div>
  
  <!-- Page Header -->
  <div class="border-b border-slate-200 bg-gradient-to-b from-red-50/30 via-white to-white">
    <div class="mx-auto max-w-[1600px] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          <%= @tag.name %> News
        </h1>
        <p class="mt-4 text-lg leading-8 text-slate-600">
          <% if @tag.taggings_count && @tag.taggings_count > 0 %>
            Browse <%= number_with_delimiter(@tag.taggings_count) %> Nintendo news articles connected to <strong class="font-semibold text-slate-900"><%= @tag.name %></strong>.
          <% else %>
            Browse Nintendo news articles connected to <strong class="font-semibold text-slate-900"><%= @tag.name %></strong>.
          <% end %>
        </p>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="mx-auto max-w-[1600px] px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <!-- Articles Grid -->
    <div class="mb-8">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 class="text-2xl font-bold tracking-tight text-slate-900">
            Latest <%= @tag.name %> Articles
          </h2>
          <p class="mt-2 text-base text-slate-600">Articles are ordered by publication date.</p>
        </div>
        <% if @pagy.count.positive? %>
          <span class="inline-flex items-center rounded-full bg-[#FFE5E7] px-3 py-1 text-sm font-medium text-[#E60012] ring-1 ring-inset ring-[#E60012]/20">
            <%= pluralize(number_with_delimiter(@pagy.count), 'article') %>
          </span>
        <% end %>
      </div>

      <% if @entries.any? %>
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          <%= render partial: 'entries/entry', collection: @entries %>
        </div>
      <% else %>
        <p class="rounded-lg bg-slate-50 p-6 text-slate-700 ring-1 ring-slate-200">
          No articles are currently linked to this topic.
        </p>
      <% end %>
    </div>

    <!-- Pagination -->
    <% if @pagy.pages > 1 %>
      <nav class="mt-12 flex justify-center" aria-label="Pagination">
        <div class="rounded-lg bg-white px-4 py-3 shadow-sm ring-1 ring-slate-200">
          <%== pagy_nav(@pagy) %>
        </div>
      </nav>
    <% end %>
  </div>
</div>
