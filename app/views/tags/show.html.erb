<div class="bg-white">
  <!-- Page Header -->
  <div class="border-b border-slate-200 bg-gradient-to-b from-indigo-50/20 via-white to-white">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          <%= @tag.name %>
        </h1>
        <p class="mt-4 text-lg leading-8 text-slate-600">
          Discover the latest news and updates about <%= @tag.name %>.
        </p>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <!-- Articles Grid -->
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <%= render partial: 'entries/entry', collection: @entries %>
    </div>

    <!-- Pagination -->
    <% if @pagy.pages > 1 %>
      <div class="mt-12 flex justify-center">
        <div class="rounded-lg bg-white px-4 py-3 shadow-sm ring-1 ring-slate-200">
          <%== pagy_nav(@pagy) %>
        </div>
      </div>
    <% end %>
  </div>
</div>

