<div class="bg-white">
  <!-- Breadcrumbs -->
  <div class="mx-auto max-w-[1600px] px-4 pt-12 sm:px-6 lg:px-8">
    <%= render 'layouts/breadcrumbs' %>
  </div>
  
  <!-- Page Header -->
  <div class="border-b border-slate-200 bg-gradient-to-b from-red-50/30 via-white to-white">
    <div class="mx-auto max-w-[1600px] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          <%= @tag.name %> News
        </h1>
        <p class="mt-4 text-lg leading-8 text-slate-600">
          <% if @tag.taggings_count && @tag.taggings_count > 0 %>
            Browse <%= number_with_delimiter(@tag.taggings_count) %> Nintendo news articles connected to <strong class="font-semibold text-slate-900"><%= @tag.name %></strong>.
          <% else %>
            Browse Nintendo news articles connected to <strong class="font-semibold text-slate-900"><%= @tag.name %></strong>.
          <% end %>
        </p>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="mx-auto max-w-[1600px] px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <% if @matching_developer.present? || @matching_genre.present? %>
      <section class="mb-14 rounded-2xl bg-slate-50 px-6 py-8 ring-1 ring-slate-200">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">About This Topic Page</h2>
        <div class="mt-4 space-y-4 text-base leading-7 text-slate-600">
          <p>
            This page is the Nintendo news archive for <strong class="font-semibold text-slate-900"><%= @tag.name %></strong>.
            It is designed to collect articles and updates connected to this topic over time.
          </p>
          <% if @matching_developer.present? %>
            <p>
              Looking for the Nintendo Switch developer catalog instead of the news archive?
              <%= link_to "#{@matching_developer.name} developer page", developer_path(@matching_developer), class: "font-medium text-[#E60012] hover:text-[#CC0010]" %>
              lists the studio profile, linked games, and genre coverage separately.
            </p>
          <% end %>
          <% if @matching_genre.present? %>
            <p>
              Looking for the Nintendo Switch genre landing page instead of the topic archive?
              <%= link_to "#{@matching_genre.name} genre page", genre_path(@matching_genre), class: "font-medium text-[#E60012] hover:text-[#CC0010]" %>
              focuses on game discovery, ratings, and related developers.
            </p>
          <% end %>
        </div>
      </section>
    <% end %>

    <% if @related_games.any? %>
      <section class="mb-14">
        <div class="mb-8">
          <h2 class="text-2xl font-bold tracking-tight text-slate-900">Related Games</h2>
          <p class="mt-2 max-w-3xl text-base leading-7 text-slate-600">
            Nintendo Switch games that appear in articles tagged with <%= @tag.name %>.
          </p>
        </div>
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
          <%= render partial: 'games/game', collection: @related_games %>
        </div>
      </section>
    <% end %>

    <!-- Articles Grid -->
    <div class="mb-8">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 class="text-2xl font-bold tracking-tight text-slate-900">
            Latest <%= @tag.name %> Articles
          </h2>
          <p class="mt-2 text-base text-slate-600">Articles are ordered by publication date.</p>
        </div>
        <% if @pagy.count.positive? %>
          <span class="inline-flex items-center rounded-full bg-[#FFE5E7] px-3 py-1 text-sm font-medium text-[#E60012] ring-1 ring-inset ring-[#E60012]/20">
            <%= pluralize(number_with_delimiter(@pagy.count), 'article') %>
          </span>
        <% end %>
      </div>

      <% if @entries.any? %>
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          <%= render partial: 'entries/entry', collection: @entries %>
        </div>
      <% else %>
        <p class="rounded-lg bg-slate-50 p-6 text-slate-700 ring-1 ring-slate-200">
          No articles are currently linked to this topic.
        </p>
      <% end %>
    </div>

    <!-- Pagination -->
    <% if @pagy.pages > 1 %>
      <nav class="mt-12 flex justify-center" aria-label="Pagination">
        <div class="rounded-lg bg-white px-4 py-3 shadow-sm ring-1 ring-slate-200">
          <%== pagy_nav(@pagy) %>
        </div>
      </nav>
    <% end %>
  </div>
</div>
